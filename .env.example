# Local Docker Postgres (swap for the Neon connection string in production)
DATABASE_URL=postgresql://lolstats:lolstats@localhost:5432/lolstats

# API
PORT=3001

# Leaguepedia (optional: anonymous access is used when unset)
LEAGUEPEDIA_BOT_USER=
LEAGUEPEDIA_BOT_PASSWORD=

# Production (Neon). Use the DIRECT connection string (pooling off) from Neon > Connect.
# Used only when copying data to production; local work keeps using DATABASE_URL above.
PROD_DATABASE_URL=

# Cloudflare R2 (images). From R2 > Manage API tokens; R2_PUBLIC_URL is the bucket public URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lol-stats-images
R2_PUBLIC_URL=
